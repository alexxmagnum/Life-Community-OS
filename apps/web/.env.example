# Life Community OS — web application environment template
# Copy to apps/web/.env.local

NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local-only Life Map visual preview (development). Keep unset in production.
# NEXT_PUBLIC_LIFE_MAP_DEV=1
# Renderer engine for /map preview: maplibre (default) | three
# NEXT_PUBLIC_LIFE_MAP_ENGINE=maplibre
# Hybrid MapLibre + Three building extrusions (default on with LIFE_MAP_DEV=1). Opt out: 0
# NEXT_PUBLIC_LIFE_MAP_3D=1
