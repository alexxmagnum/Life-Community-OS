# Life Community OS — web application environment template
# Copy to apps/web/.env.local

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Active tenant pack slug (life-panoramica | life-valley)
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=life-panoramica

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Client demo / pilot (recommended defaults) ──────────────────────────────
# Keep these unset for first-client demos:
#   NEXT_PUBLIC_LCOS_DEMO_ROLES
#   NEXT_PUBLIC_LIFE_MAP_DEV
#   NEXT_PUBLIC_LIFE_MAP_3D
# See docs/product/PILOT_HANDOFF.md

# ── Production cutover (see ADR-PRODUCTION-CUTOVER.md) ──────────────────────
# Enforce real Supabase Auth on member routes (requires configured keys)
# LCOS_AUTH_REQUIRED=true
# Prefer user-scoped RLS clients when set (requires access token on request)
# SUPABASE_USE_RLS=1
# Demo lifestyle copy on empty Location fields — off in production by default:
# NEXT_PUBLIC_LCOS_DEMO_PLACE_PROFILES=1

# Address geocoder (server)
# ADDRESS_GEOCODER_PROVIDER=nominatim
# ADDRESS_GEOCODER_ENDPOINT=
# ADDRESS_GEOCODER_USER_AGENT=LifeCommunityOS/0.1

# Life Map — Panoramica enables lifeMap via tenant feature (customer demo).
# Optional local unlock if a tenant keeps lifeMap off (never for client demos):
# NEXT_PUBLIC_LIFE_MAP_DEV=1
# Renderer: maplibre (default) | three (legacy prototype)
# NEXT_PUBLIC_LIFE_MAP_ENGINE=maplibre
# Hybrid Three overlay (off by default — commercial map-first).
# NEXT_PUBLIC_LIFE_MAP_3D=1
#
# Basemap is self-hosted (tenant GeoJSON). No Mapbox / MapTiler / ESRI keys required.
