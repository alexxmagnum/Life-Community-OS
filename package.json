{
  "name": "life-community-os",
  "private": true,
  "version": "0.0.0",
  "description": "Life Community OS — Foundation Phase monorepo",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @life-community-os/web dev",
