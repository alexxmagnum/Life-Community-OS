{
  "name": "life-community-os",
  "private": true,
  "version": "0.0.0",
  "description": "Life Community OS — Foundation Phase monorepo",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @life-community-os/web dev",
    "build": "pnpm --filter @life-community-os/web build",
    "lint": "pnpm --filter @life-community-os/web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "assets:generate": "pnpm --filter @life-community-os/assets generate",
    "assets:validate": "pnpm --filter @life-community-os/assets validate",
    "assets:test": "pnpm --filter @life-community-os/assets test",
    "test:identity": "pnpm --filter @life-community-os/auth test && pnpm --filter @life-community-os/web test:isolation"
  },
  "engines": {
    "node": ">=20"
  }
}
